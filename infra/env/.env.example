# Copy to infra/.env to override compose defaults. Development values only.

# Base image for the backend and worker builds.
PYTHON_BASE=python:3.13-slim-bookworm

# Hosts the browser uses. Tokens carry the Keycloak hostname as their issuer, so the API
# must be configured with the same one; presigned URLs must point at a host the browser can reach.
STUDIO_AUTH_ISSUER=http://localhost:8080/realms/studio
STUDIO_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

SEAWEEDFS_VERSION=4.50
KEYCLOAK_VERSION=26.4

# AI provider for the ai worker (anthropic | openai | gemini | deepseek | openai_compatible) and its key.
STUDIO_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Media worker (lip sync, Phase 6) ---
# ffmpeg normalises dialogue recordings; Rhubarb Lip Sync 1.14.0 (installed in the
# worker-media image) finds the mouth cues. Set it empty to use the built-in phonetic
# analyser instead.
STUDIO_FFMPEG_BINARY=ffmpeg
STUDIO_RHUBARB_BINARY=/usr/local/bin/rhubarb
